{
  "name": "Continuum — Console Library",
  "short_name": "Continuum",
  "description": "A WebGPU emulator front end for retro consoles, built on a Rust engine shared with the native app.",
  "id": "/continuum/",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#08080c",
  "theme_color": "#08080c",
  "categories": ["games", "entertainment", "utilities"],
  "icons": [
    {
      "src": "./icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "prefer_related_applications": false
}

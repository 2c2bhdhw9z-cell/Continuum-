      "sizeBytes": 2089396,
      "targetFps": 60.0988,
      "audioSampleRate": 48000,
      "pixelFormat": "rgb565",
      "geometry": {
        "baseWidth": 256,
        "baseHeight": 240,
        "maxWidth": 256,

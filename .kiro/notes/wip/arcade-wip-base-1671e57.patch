@@ -0,0 +1,79 @@
+mod galaxian;
+use galaxian::*;
+
+const P: u32 = 131_071;
+
+fn stars() -> Vec<u8> {
+    let mut t = vec![0u8; P as usize];
+    let mut sr: u32 = 0;
+    for e in t.iter_mut() {
+        let lit = (sr & 0x1FE01) == 0x1FE00;
+        *e = (((!sr & 0x1F8) >> 3) as u8) | u8::from(lit) << 7;
+        sr = (sr >> 1) | ((((sr >> 12) ^ !sr) & 1) << 16);
+    }
+    t
+}
+
+#[test]
+fn dbg() {
+    let case = cases().into_iter().find(|c| c.name == std::env::var("CASE").unwrap()).unwrap();
+    let frames: u32 = std::env::var("FRAMES").unwrap().parse().unwrap();
+    let ours = run_ours(&Case { frames, ..case });
+    let dir = crate_dir().join("target/mame-runs/galaxian").join(case.name);
+    let mame = read_png(&dir.join("snap").join(format!("f{:05}.png", frames - 1)));
+    let last = &ours[frames as usize - 1];
+    let n = last.iter().zip(&mame).filter(|(a, b)| a != b).count();
+    eprintln!("RESULT frame {frames}: {n} pixels differ");
+    write_png(&dir.join(format!("ours-{frames:05}.png")), last);
+    if let Ok(range) = std::env::var("SEARCH") {
+        // Lines lo..=hi: which origin makes the star dots where ours and MAME's differ agree?
+        let mut it = range.split(',');
+        let lo: usize = it.next().unwrap().parse().unwrap();
+        let hi: usize = it.next().unwrap().parse().unwrap();
+        let t = stars();
+        // The raster pixel at (line y, dot x) is upright (223 - (y - 16), x).
+        let at = |img: &[u32], y: usize, x: usize| img[x * 224 + (223 - (y - 16))];
+        let mut cands: Vec<u32> = Vec::new();
+        'find: for y in lo..=hi {
+            for x in 0..768 {
+                let (o, m) = (at(last, y, x), at(&mame, y, x));
+                if o != m && m != 0 {
+                    // MAME has a dot ours lacks: the generator's state there is lit.
+                    let step = (x / 3) * 2 + usize::from(x % 3 != 0);
+                    for (i, &s) in t.iter().enumerate() {
+                        if s & 0x80 != 0 {
+                            let base = (i as i64 - (y as i64 * 512 + step as i64)).rem_euclid(P as i64) as u32;
+                            cands.push(base);
+                        }
+                    }
+                    eprintln!("first MAME-only dot: line {y} dot {x} colour {m:06x}; {} candidates", cands.len());
+                    break 'find;
+                }
+            }
+        }
+        for c in cands {
+            // Score: lines lo..hi, dots where ours and MAME differ: does origin c light MAME's?
+            let mut good = 0;
+            let mut bad = 0;
+            for y in lo..=hi {
+                for x in 0..768 {
+                    let (o, m) = (at(last, y, x), at(&mame, y, x));
+                    if o == m {
+                        continue;
+                    }
+                    let step = (x / 3) * 2 + usize::from(x % 3 != 0);
+                    let idx = ((u64::from(c) + y as u64 * 512 + step as u64) % u64::from(P)) as usize;
+                    let shown = (y ^ (x / 3 >> 3)) & 1 != 0;
+                    if (m != 0) == (shown && t[idx] & 0x80 != 0) {
+                        good += 1;
+                    } else {
+                        bad += 1;
+                    }
+                }
+            }
+            if bad * 4 < good {
+                eprintln!("origin {c}: {good} agree, {bad} don't");
+            }
+        }
+    }
+}

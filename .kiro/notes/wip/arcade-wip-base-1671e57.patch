diff --git a/cores/continuum-arcade/test-programs/galaxian/start.inc b/cores/continuum-arcade/test-programs/galaxian/start.inc
new file mode 100644
index 0000000..95fc690
--- /dev/null
+++ b/cores/continuum-arcade/test-programs/galaxian/start.inc
@@ -0,0 +1,109 @@
+; The frame loop every Galaxian-board test program shares (GPL-3.0-only). The program supplies:
+;   init   - set up, then JP run (BOOTS counts the warm boots before it)
+;   frame  - called from the NMI with HL = the frame count (1 at the first one)
+;   idle   - called after each NMI, outside it (may delay, to place writes mid-frame)
+; VBLANK raises the NMI; the handler drops the line and raises the enable again, as the games do,
+; unless NMIKEEP (the line stays high, so no further NMI comes) or NMIOFF (the enable stays off).
+
+    DEVICE NOSLOT64K
+    org 0
+reset:
+    di
+    ld sp, STACK
+    jp boot
+
+    org 0x66
+nmi:
+    push af
+    push bc
+    push de
+    push hl
+    push ix
+    push iy
+    ld a, (NMIKEEP)
+    or a
+    jr nz, .keep
+    xor a
+    ld (NMIEN), a           ; the line drops
+.keep:
+    ld a, (NOKICK)
+    or a
+    jr nz, .nokick
+    ld a, (WDOG)            ; kicks the watchdog
+.nokick:
+    ld hl, (FRAMES)
+    inc hl
+    ld (FRAMES), hl
+    call frame
+    ld a, (NMIKEEP)
+    ld b, a
+    ld a, (NMIOFF)
+    or b
+    jr nz, .off
+    ld a, 1
+    ld (NMIEN), a
+.off:
+    pop iy
+    pop ix
+    pop hl
+    pop de
+    pop bc
+    pop af
+    retn
+
+boot:
+    ; A warm boot (the watchdog's reset) keeps RAM: count it instead of clearing.
+    ld hl, (MAGIC)
+    ld de, 0x5AA5
+    or a
+    sbc hl, de
+    jr z, .warm
+    ld hl, RAM
+    ld de, RAM + 1
+    ld bc, 0x3FF
+    ld (hl), 0
+    ldir
+    ld hl, 0x5AA5
+    ld (MAGIC), hl
+    jp init
+.warm:
+    ld hl, BOOTS
+    inc (hl)
+    jp init
+
+run:
+    ld a, 1
+    ld (NMIEN), a
+.loop:
+    halt
+    call idle
+    jr .loop
+
+; Waits about BC * 26 + 20 T-states (BC at least 1).
+delay:
+    dec bc
+    ld a, b
+    or c
+    jr nz, delay
+    ret
+
+; Fills BC bytes (at least 2) at HL with A.
+fill:
+    ld (hl), a
+    ld d, h
+    ld e, l
+    inc de
+    dec bc
+    ldir
+    ret
+
+; Sets each column's colour byte to its number plus A (the low three bits are the colour).
+colours:
+    ld hl, SCROLL + 1
+    ld b, 32
+.c: ld (hl), a
+    inc a
+    inc hl
+    inc hl
+    djnz .c
+    ret
diff --git a/cores/continuum-arcade/test-programs/galaxian/tiles.asm b/cores/continuum-arcade/test-programs/galaxian/tiles.asm
new file mode 100644
index 0000000..9653e7d
--- /dev/null
+++ b/cores/continuum-arcade/test-programs/galaxian/tiles.asm
@@ -0,0 +1,200 @@
+; Galaxian board test: the tile layer (GPL-3.0-only, cArcade's own).
+; Fills video RAM with every tile code and gives the 32 columns every colour (with junk in the
+; colour bytes' top bits), then each frame scrolls each column by its own step, changes a band of
+; 32 tile codes, and every 4 frames moves the colours on. The screen flips: x at 40, y at 70, x
+; off at 100, y off at 130, then x every 9 frames and y every 13. Writes and reads go through the
+; mirrors of video, object and work RAM, and reads of nothing and of the input ports show as tiles.
+
+    DEFINE OUTNAME "tiles.bin"
+    include "hw.inc"
+    include "start.inc"
+
+FXC     equ USER        ; frames to the next x flip
+FYC     equ USER + 1
+FXV     equ USER + 2    ; the flips as set
+FYV     equ USER + 3
+
+init:
+    ld hl, VRAM
+    ld a, 3
+    ld e, 7
+    call fill1k
+    ; column n: scroll 9n, colour byte 25h * n
+    ld hl, SCROLL
+    ld b, 32
+    xor a
+    ld c, a
+.col:
+    ld (hl), a
+    inc hl
+    ld (hl), c
+    inc hl
+    add a, 9
+    ld d, a
+    ld a, c
+    add a, 0x25
+    ld c, a
+    ld a, d
+    djnz .col
+    ; no sprites or shots
+    ld hl, OBJ + 0x40
+    ld bc, 0xC0
+    xor a
+    call fill
+    ld a, 9
+    ld (FXC), a
+    ld a, 13
+    ld (FYC), a
+    jp run
+
+; 1 KB at HL from A, adding E each byte.
+fill1k:
+    ld c, 4
+.o: ld b, 0
+.i: ld (hl), a
+    add a, e
+    inc hl
+    djnz .i
+    dec c
+    jr nz, .o
+    ret
+
+frame:
+    push hl
+    ; each column scrolls by its own step, 1 to 4 lines a frame
+    ld ix, SCROLL
+    ld b, 32
+    ld c, 0
+.sc:
+    ld a, c
+    and 3
+    inc a
+    add a, (ix + 0)
+    ld (ix + 0), a
+    inc ix
+    inc ix
+    inc c
+    djnz .sc
+    pop hl
+    push hl
+    ; the band: 32 codes at (frame & 31) * 32
+    ld a, l
+    and 0x1F
+    ld l, a
+    ld h, 0
+    add hl, hl
+    add hl, hl
+    add hl, hl
+    add hl, hl
+    add hl, hl
+    ld de, VRAM
+    add hl, de
+    ld b, 32
+.band:
+    inc (hl)
+    inc hl
+    djnz .band
+    pop hl
+    push hl
+    ; every 4 frames the colours move on, junk bits and all
+    ld a, l
+    and 3
+    jr nz, .nocol
+    ld ix, SCROLL + 1
+    ld b, 32
+.cl:
+    ld a, (ix + 0)
+    add a, 0x21
+    ld (ix + 0), a
+    inc ix
+    inc ix
+    djnz .cl
+.nocol:
+    pop hl
+    push hl
+    call flips
+    pop hl
+    ; the mirrors: video RAM at 5400h, object RAM to 5FFFh, work RAM at 4400h
+    ld a, l
+    ld (VRAM + 0x400 + 0x1E5), a
+    ld a, (VRAM + 0x400 + 0x0C0)
+    ld (VRAM + 0x3E0), a
+    ld a, l
+    and 0x3F
+    ld (OBJ + 0x700 + 0x3E), a      ; column 31's scroll, through the last mirror
+    ld a, (OBJ + 0x300 + 0x3D)      ; column 30's colour, read through a mirror
+    ld (VRAM + 0x3E1), a
+    ld a, l
+    ld (RAM + 0x400 + 0x80), a
+    ld a, (RAM + 0x80)
+    ld (VRAM + 0x3E2), a
+    ; reads of nothing give FFh; the inputs read nothing pressed
+    ld a, (UNMAP)
+    ld (VRAM + 0x3E3), a
+    ld a, (0xC123)
+    ld (VRAM + 0x3E4), a
+    ld a, (IN0)
+    ld (VRAM + 0x3E5), a
+    ld a, (IN1)
+    ld (VRAM + 0x3E6), a
+    ld a, (IN2)
+    ld (VRAM + 0x3E7), a
+    ret
+
+flips:
+    ld a, h
+    or a
+    jr nz, .late
+    ld a, l
+    cp 40
+    jr z, .xon
+    cp 70
+    jr z, .yon
+    cp 100
+    jr z, .xoff
+    cp 130
+    jr z, .yoff
+    cp 140
+    ret c
+.late:
+    ld hl, FXC
+    dec (hl)
+    jr nz, .ny
+    ld (hl), 9
+    ld a, (FXV)
+    xor 1
+    ld (FXV), a
+    ld (FLIPX), a
+.ny:
+    ld hl, FYC
+    dec (hl)
+    ret nz
+    ld (hl), 13
+    ld a, (FYV)
+    xor 1
+    ld (FYV), a
+    ld (FLIPY), a
+    ret
+.xon:
+    ld a, 1
+    jr .x
+.xoff:
+    xor a
+.x:
+    ld (FXV), a
+    ld (FLIPX), a
+    ret
+.yon:
+    ld a, 1
+    jr .y
+.yoff:
+    xor a
+.y:
+    ld (FYV), a
+    ld (FLIPY), a
+    ret
+
+idle:
+    ret
+
+    include "end.inc"

+#[test]
+fn trace_reads() {
+    let Ok(path) = std::env::var("CBOY_READS") else { return };
+    let data = std::fs::read(path).unwrap();
+    let mut gb = GameBoy::new_mode(data, false).unwrap();
+    continuum_gb::bus::TRACE_READS.store(true, std::sync::atomic::Ordering::Relaxed);
+    for _ in 0..60 {
+        gb.run_frame();
+        if gb.cpu.ld_b_b {
+            break;
+        }
+    }
+    continuum_gb::bus::TRACE_READS.store(false, std::sync::atomic::Ordering::Relaxed);
+}
+
+#[test]
+fn trace_writes() {
+    let Ok(name) = std::env::var("CBOY_ROM") else { return };
+    let cgb = std::env::var("CBOY_CGB").is_ok();
+    let dir = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("test-roms/mealybug");
+    let data = std::fs::read(dir.join(format!("{name}.gb"))).unwrap();
+    let mut gb = if cgb { GameBoy::with_model(data, Model::Cgb, None).unwrap() } else { GameBoy::new_mode(data, false).unwrap() };
+    gb.bus.ppu.exact = true;
+    for _ in 0..600 {
+        gb.run_frame();
+        if gb.cpu.ld_b_b {
+            break;
+        }
+    }
+    gb.run_frame();
+    continuum_gb::bus::TRACE.store(true, std::sync::atomic::Ordering::Relaxed);
+    gb.run_frame();
+    continuum_gb::bus::TRACE.store(false, std::sync::atomic::Ordering::Relaxed);
+}

new file mode 100644
index 0000000..4feb8d9
--- /dev/null
+++ b/cores/continuum-arcade/src/dkong_sound.rs
@@ -0,0 +1,47 @@
+//! Donkey Kong's and Donkey Kong Jr.'s sound circuits, after the 8035: placeholder until the
+//! approximated analogue effects land (the DAC only, unfiltered).
+
+use serde::{Deserialize, Serialize};
+
+/// The sound handed out.
+pub const RATE: u32 = 48_000;
+
+/// What reaches the sound circuits, and when (attoseconds since power-on).
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub enum Input {
+    /// The 8035's port 1, into the DAC.
+    Dac(u8),
+    /// The 8035's port 2 bit 7 (high: the DAC's decay circuit is off).
+    Decay(bool),
+    /// Latch 6H, whose bits start the analogue effects.
+    Latch6h(u8),
+    /// Donkey Kong Jr.'s latch 5H bit 1 (falling).
+    Sound9(bool),
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Sound {
+    jr: bool,
+    dac: u8,
+}
+
+impl Sound {
+    pub fn new(jr: bool) -> Sound {
+        Sound { jr, dac: 0 }
+    }
+
+    pub fn reset(&mut self) {
+        *self = Sound::new(self.jr);
+    }
+
+    pub fn set(&mut self, input: Input) {
+        if let Input::Dac(v) = input {
+            self.dac = v;
+        }
+    }
+
+    /// One sample, -1.0 to 1.0.
+    pub fn next(&mut self) -> f64 {
+        (f64::from(self.dac) - 128.0) / 256.0
+    }
+}

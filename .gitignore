# Cargo build output, at any depth: a crate-level target/ (cargo run from inside a crate, or a test
# writing next to its sources) was once committed because only the root one was ignored.
target/
**/*.rs.bk

# Core sources, fetched headers and players, and other scratch fetched or built by scripts/
# (build-core.sh, fetch-*.sh, check-*.sh). All reproducible from the scripts.
/.work/

.DS_Store

# Phase 5 native build output. The wrapper is built from source by CI and by
# native/switch-wrapper/build.sh; the artefacts are not committed.
native/switch-wrapper/build/
native/continuum-symbian/build/
native/ios/build/

# Generated by XcodeGen from native/ios/project.yml. A pbxproj is a UUID-keyed plist that
# cannot be reviewed in a diff, and there is no Xcode on this project to edit one with, so
# the YAML is the source and this is output.
native/ios/*.xcodeproj/
native/ios/*.xcworkspace/

/target
**/*.rs.bk

# Build output of scripts/build-wasm.sh. Regenerated from the crate, so it is not
# source; run the script after cloning.
/web/vendor/

# Toolchains and core sources fetched by scripts/build-core.sh (wasi-sdk is ~1 GB
# extracted, core checkouts are tens of MB). Both are reproducible from the script.
/.tools/
/.work/

# Core binaries are build outputs from third-party GPL/LGPL sources, not vendored
# here: run scripts/build-core.sh <name>. The placeholder module is ours and is kept.
/web/cores/*.wasm
!/web/cores/diagnostic-core.wasm

.DS_Store

# Phase 5 native build output. The wrapper is built from source by CI and by
# native/switch-wrapper/build.sh; the artefacts are not committed.
native/switch-wrapper/build/
native/ios/build/

# Generated by XcodeGen from native/ios/project.yml. A pbxproj is a UUID-keyed plist that
# cannot be reviewed in a diff, and there is no Xcode on this project to edit one with, so
# the YAML is the source and this is output.
native/ios/*.xcodeproj/
native/ios/*.xcworkspace/

# Task Observer local logs
skill-observations/
skill-updates/

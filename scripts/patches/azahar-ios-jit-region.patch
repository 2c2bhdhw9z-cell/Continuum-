 namespace oaknut {
 
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+// Continuum: code memory from the host app, as two addresses for the same pages: one to run from
+// and one to write through. On an iPhone 13 or newer running iOS 26 the app gets a single region
+// blessed by a debugger, and that region stays read-and-execute for good, so generated code has to
+// be written through a second address. The host hands out the same pair on older iPhones too, so
+// there is one code path. Looked up by name at run time, so a host without it is unaffected and
+// the plain mapping below is used instead.
+inline bool continuum_jit_block(std::size_t size, std::uint32_t** rx, std::uint32_t** rw)
+{
+    using RegionFn = bool (*)(const char*, std::size_t, void**, void**);
+    static RegionFn region_fn = (RegionFn)dlsym(RTLD_DEFAULT, "continuum_jit_region");
+    static int counter = 0;
+    if (region_fn == nullptr)
+        return false;
+    char owner[32];
+    std::snprintf(owner, sizeof(owner), "oaknut-%d-%u", counter, (unsigned)(size >> 10));
+    void* out_rx = nullptr;
+    void* out_rw = nullptr;
+    if (!region_fn(owner, size, &out_rx, &out_rw))
+        return false;
+    counter++;
+    *rx = reinterpret_cast<std::uint32_t*>(out_rx);
+    *rw = reinterpret_cast<std::uint32_t*>(out_rw);
+    return true;
+}
+
+inline void continuum_jit_block_release(std::uint32_t* rx)
+{
+    using ReleaseFn = void (*)(void*);
+    static ReleaseFn release_fn = (ReleaseFn)dlsym(RTLD_DEFAULT, "continuum_jit_release");
+    if (release_fn != nullptr)
+        release_fn(reinterpret_cast<void*>(rx));
+}
+#endif

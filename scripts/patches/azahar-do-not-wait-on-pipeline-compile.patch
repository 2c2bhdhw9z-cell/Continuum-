diff --git a/src/video_core/renderer_vulkan/vk_graphics_pipeline.cpp b/src/video_core/renderer_vulkan/vk_graphics_pipeline.cpp
index d736c7e..74603ed 100644
--- a/src/video_core/renderer_vulkan/vk_graphics_pipeline.cpp
+++ b/src/video_core/renderer_vulkan/vk_graphics_pipeline.cpp
@@ -95,8 +95,14 @@ bool GraphicsPipeline::TryBuild(bool wait_built) {
         return false;
     }
 
-    // Ask the driver if it can give us the pipeline quickly.
-    if (!shaders_pending && instance.IsPipelineCreationCacheControlSupported() && Build(true)) {
+    // Continuum: no driver probe on the emulation thread when we will not wait.
+    // MoltenVK honours FAIL_ON_PIPELINE_COMPILE_REQUIRED only for the SPIR-V to
+    // Metal library step. Once that library is cached it goes on and builds the
+    // Metal render pipeline state right here, which is the slow part, so the
+    // "quick" probe was itself the hitch. With async pipelines (the Continuum
+    // core option) every new pipeline goes to the worker; "Old" keeps the probe.
+    if (wait_built && !shaders_pending && instance.IsPipelineCreationCacheControlSupported() &&
+        Build(true)) {
         return true;
     }
 

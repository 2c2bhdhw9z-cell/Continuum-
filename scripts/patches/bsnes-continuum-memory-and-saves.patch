@@ -1036,12 +1040,51 @@ unsigned retro_get_region()
 
 // Currently, there is no safe/sensible way to use the memory interface without severe hackery.
 // Rely on higan to load and save SRAM until there is really compelling reason not to.
+// Continuum: expose work RAM and the cartridge's battery RAM so the frontend can
+// own the .srm (periodic flush) and RetroAchievements / RAM search can read memory.
+static SuperFamicom::WritableMemory* continuum_cart_ram()
+{
+	using namespace SuperFamicom;
+	if(!emulator->loaded() || program->gameBoy.program) return nullptr;
+	if(cartridge.has.SA1) return &sa1.bwram;
+	if(cartridge.has.SuperFX) return &superfx.ram;
+	if(cartridge.has.HitachiDSP) return &hitachidsp.ram;
+	if(cartridge.has.SPC7110) return &spc7110.ram;
+	if(cartridge.has.OBC1) return &obc1.ram;
+	return &cartridge.ram;
+}
+
+// ST010 (F1 ROC II) keeps its battery RAM inside the chip; bsnes's HLE never writes it to disk.
+static uint8_t* continuum_st010_ram(size_t* size)
+{
+	using namespace SuperFamicom;
+	if(!emulator->loaded() || !cartridge.has.ST0010) return nullptr;
+	*size = sizeof(st0010.ram);
+	return st0010.ram;
+}
+
 void *retro_get_memory_data(unsigned id)
 {
+	if(!emulator->loaded() || program->gameBoy.program) return nullptr;
+	switch(id) {
+		case RETRO_MEMORY_SAVE_RAM: {
+			size_t n = 0; if(auto st = continuum_st010_ram(&n)) return st;
+			auto m = continuum_cart_ram(); return m && m->size() ? m->data() : nullptr;
+		}
+		case RETRO_MEMORY_SYSTEM_RAM: return SuperFamicom::cpu.wram;
+	}
 	return nullptr;
 }
 
 size_t retro_get_memory_size(unsigned id)
 {
+	if(!emulator->loaded() || program->gameBoy.program) return 0;
+	switch(id) {
+		case RETRO_MEMORY_SAVE_RAM: {
+			size_t n = 0; if(continuum_st010_ram(&n)) return n;
+			auto m = continuum_cart_ram(); return m ? m->size() : 0;
+		}
+		case RETRO_MEMORY_SYSTEM_RAM: return 128 * 1024;
+	}
 	return 0;
 }

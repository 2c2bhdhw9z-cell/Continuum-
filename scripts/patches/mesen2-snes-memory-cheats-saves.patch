+	// Continuum: SNES memory, cheats and battery for the frontend.
+	// An SNES part is a Game Genie code (XXXX-XXXX) or a Pro Action Replay code, the address and
+	// then the value, written AAAAAAVV or AAAAAA:VV (or AAAAAA=VV), the spellings bsnes takes.
+	static bool continuum_parse_snes_cheat_part(string part, CheatCode& out)
+	{
+		static const string hex = "0123456789ABCDEF";
+		auto all_in = [](const string& s, const string& set) {
+			return !s.empty() && s.find_first_not_of(set) == string::npos;
+		};
+		std::transform(part.begin(), part.end(), part.begin(), ::toupper);
+		string text;
+		memset(&out, 0, sizeof(out));
+		if(part.size() == 9 && part[4] == '-' && all_in(part.substr(0, 4), hex) && all_in(part.substr(5, 4), hex)) {
+			out.Type = CheatType::SnesGameGenie;
+			text = part;
+		} else if(part.size() == 8 && all_in(part, hex)) {
+			out.Type = CheatType::SnesProActionReplay;
+			text = part;
+		} else if(part.size() == 9 && (part[6] == ':' || part[6] == '=') && all_in(part.substr(0, 6), hex) &&
+		          all_in(part.substr(7, 2), hex)) {
+			out.Type = CheatType::SnesProActionReplay;
+			text = part.substr(0, 6) + part.substr(7, 2);
+		} else {
+			return false;
+		}
+		strncpy(out.Code, text.c_str(), sizeof(out.Code) - 1);
+		return true;
+	}

+	static ConsoleMemoryInfo continuum_memory(unsigned id)
+	{
+		ConsoleMemoryInfo none = {};
+		if(!_emu || !_emu->GetConsole() || _emu->GetConsole()->GetConsoleType() != ConsoleType::Snes) {
+			return continuum_nes_memory(id);
+		}
+		switch(id) {
+			case RETRO_MEMORY_SAVE_RAM: {
+				auto snes = std::dynamic_pointer_cast<SnesConsole>(_emu->GetConsole());
+				return snes && snes->GetCartridge() ? snes->GetCartridge()->ContinuumBatteryRam() : none;
+			}
+			case RETRO_MEMORY_SYSTEM_RAM: return _emu->GetMemory(MemoryType::SnesWorkRam);

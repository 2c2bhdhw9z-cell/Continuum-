@@ -381,9 +381,37 @@ CartFlags::CartFlags BaseCartridge::GetCartFlags()
 	return _flags;
 }
 
-void BaseCartridge::LoadBattery()
+//Continuum: the RAM Mesen keeps as this game's .srm, which the frontend saves instead when it owns
+//the battery save. The same choice LoadBattery and SaveBattery make: a chip that keeps the game's
+//save in RAM of its own writes the .srm after the cartridge RAM, so its RAM is what the file holds.
+ConsoleMemoryInfo BaseCartridge::ContinuumBatteryRam()
 {
+	if(_coprocessor && _hasBattery) {
+		switch(_coprocessorType) {
+			case CoprocessorType::GSU: return _emu->GetMemory(MemoryType::GsuWorkRam);
+			case CoprocessorType::ST010:
+			case CoprocessorType::ST011: return _emu->GetMemory(MemoryType::DspDataRam);
+			case CoprocessorType::SA1:
+				if(_saveRamSize == 0) {
+					return _emu->GetMemory(MemoryType::Sa1InternalRam);
+				}
+				break;
+			default: break;
+		}
+	}
+	ConsoleMemoryInfo ram = {};
 	if(_saveRamSize > 0) {
+		ram.Memory = _saveRam;
+		ram.Size = _saveRamSize;
+	}
+	return ram;
+}
+
+void BaseCartridge::LoadBattery()
+{
+	//Continuum: the frontend restores the .srm itself when it owns the battery save (the cartridge
+	//RAM here, and the chips' own .srm below); clocks and memory packs keep their files.
+	if(_saveRamSize > 0 && !BatteryManager::FrontendOwnsSaveRam()) {
 		_emu->GetBatteryManager()->LoadBattery(".srm", _saveRam, _saveRamSize);
 	}
 
@@ -398,7 +426,7 @@ void BaseCartridge::LoadBattery()
 
 void BaseCartridge::SaveBattery()
 {
-	if(_saveRamSize > 0) {
+	if(_saveRamSize > 0 && !BatteryManager::FrontendOwnsSaveRam()) {
 		_emu->GetBatteryManager()->SaveBattery(".srm", _saveRam, _saveRamSize);
 	}
 

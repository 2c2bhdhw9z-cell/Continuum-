@@ -54,6 +58,35 @@ static int ashmem_create_region(const char *name, size_t size)
 namespace virtmem
 {
 
+#if defined(TARGET_IPHONE)
+// Continuum: code memory from the host app, as two addresses for the same pages (one to run from,
+// one to write through). On an iPhone 13 or newer running iOS 26 that is the only memory generated
+// code may ever live in, and the host hands out the same pair on older iPhones so there is a single
+// code path. Looked up by name at run time, so this build also works in a frontend without it.
+static bool continuum_jit_block(size_t size, void **rx, void **rw)
+{
+	typedef bool (*RegionFn)(const char *, size_t, void **, void **);
+	static RegionFn region_fn = (RegionFn)dlsym(RTLD_DEFAULT, "continuum_jit_region");
+	static int counter = 0;
+	if (region_fn == nullptr)
+		return false;
+	char owner[32];
+	snprintf(owner, sizeof(owner), "flycast-%d-%u", counter, (unsigned)(size >> 10));
+	if (!region_fn(owner, size, rx, rw))
+		return false;
+	counter++;
+	return true;
+}
+
+static void continuum_jit_block_release(void *rx)
+{
+	typedef void (*ReleaseFn)(void *);
+	static ReleaseFn release_fn = (ReleaseFn)dlsym(RTLD_DEFAULT, "continuum_jit_release");
+	if (release_fn != nullptr)
+		release_fn(rx);
+}
+#endif
+
 bool region_lock(void *start, size_t len)
 {
 	size_t inpage = (uintptr_t)start & PAGE_MASK;
@@ -289,6 +322,24 @@ void release_jit_block(void *code_area, size_t size)
 // Use two addr spaces: need to remap something twice, therefore use allocate_shared_filemem()
 bool prepare_jit_block(void *code_area, size_t size, void **code_area_rw, ptrdiff_t *rx_offset)
 {
+#if defined(TARGET_IPHONE)
+	// Continuum: from the host app, which owns the only memory an iPhone may run generated code
+	// from. `rx_offset` is how far the running address sits from the writing one, which is exactly
+	// what the recompilers already add when FEAT_NO_RWX_PAGES is set.
+	{
+		void *region_rx = nullptr;
+		void *region_rw = nullptr;
+		if (continuum_jit_block(size, &region_rx, &region_rw))
+		{
+			*code_area_rw = region_rw;
+			*rx_offset = (char *)region_rx - (char *)region_rw;
+			INFO_LOG(DYNAREC, "Code from the host region: rx %p rw %p", region_rx, region_rw);
+			return true;
+		}
+		WARN_LOG(DYNAREC, "The host has no code region, so the recompiler cannot start");
+		return false;
+	}
+#endif
 	int fd = allocate_shared_filemem(size);
 	if (fd < 0)
 		return false;
@@ -319,6 +370,14 @@ bool prepare_jit_block(void *code_area, size_t size, void **code_area_rw, ptrdif
 
 void release_jit_block(void *code_area1, void *code_area2, size_t size)
 {
+#if defined(TARGET_IPHONE)
+	// Continuum: handed back to the host so the next game can use it, never unmapped: the pages
+	// belong to the app's one blessed region.
+	(void)size;
+	(void)code_area2;
+	continuum_jit_block_release(code_area1);
+	return;
+#endif
 	// keep code_area1 (RX) mapped since it's statically allocated
 	munmap(code_area2, size);
 }

diff --git a/src/Input.cpp b/src/Input.cpp
index 94a6bda..0c5f307 100644
--- a/src/Input.cpp
+++ b/src/Input.cpp
@@ -107,6 +107,16 @@ void Input::SyncSportsPad(stSportsPad* sports_pad)
         return;
 
     u64 current_clock = *m_pMasterClockCycles;
+    // Continuum: a pad nobody plugged in has no timing of its own, and plugging one in resets it
+    // (EnableSportsPad), so counting cycles for it changes nothing a player sees. It did change
+    // the save state: how much time had piled up depended on when the frontend happened to save,
+    // and online play compares a hash of the whole state, so two phones at the same point in the
+    // same game never matched. Keep the anchor up to date and count nothing.
+    if (!sports_pad->enabled)
+    {
+        sports_pad->last_clock = current_clock;
+        return;
+    }
     if (current_clock < sports_pad->last_clock)
     {
         sports_pad->last_clock = current_clock;
@@ -438,8 +448,31 @@ void Input::SaveState(std::ostream& stream)
     stream.write(reinterpret_cast<const char*> (&m_bPhaser), sizeof(m_bPhaser));
     stream.write(reinterpret_cast<const char*> (&m_Phaser), sizeof(m_Phaser));
     stream.write(reinterpret_cast<const char*> (&m_bPaddle), sizeof(m_bPaddle));
+    // Continuum: same as the light phaser in Video. These spare bytes are not part of the
+    // machine and were never written, so they went into the state as leftovers from memory and
+    // the two phones' states disagreed. Zero them first.
+    memset(m_Paddle.continuum_spare, 0, sizeof(m_Paddle.continuum_spare));
+    memset(m_SportsPad[0].continuum_spare, 0, sizeof(m_SportsPad[0].continuum_spare));
+    memset(m_SportsPad[1].continuum_spare, 0, sizeof(m_SportsPad[1].continuum_spare));
     stream.write(reinterpret_cast<const char*> (&m_Paddle), sizeof(m_Paddle));
+
+    // Continuum: last_clock is this machine's own master clock, which the state does not carry,
+    // so the same moment in the same game was a different number on each phone. Write it as
+    // cycles since now, the way the Game Gear link cable already writes its timing, and put the
+    // live value back afterwards so saving a state does not disturb the game. LoadState sets
+    // last_clock from the loading machine's own clock either way, so nothing changes for a state
+    // that is loaded back.
+    u64 current_clock = m_pMasterClockCycles ? *m_pMasterClockCycles : 0;
+    u64 live_clock[2] = { m_SportsPad[0].last_clock, m_SportsPad[1].last_clock };
+    for (int i = 0; i < 2; i++)
+    {
+        m_SportsPad[i].last_clock = (current_clock >= live_clock[i])
+            ? (current_clock - live_clock[i]) : 0;
+    }
     stream.write(reinterpret_cast<const char*> (&m_SportsPad), sizeof(m_SportsPad));
+    m_SportsPad[0].last_clock = live_clock[0];
+    m_SportsPad[1].last_clock = live_clock[1];
+
     stream.write(reinterpret_cast<const char*> (&m_bResetPressed), sizeof(m_bResetPressed));
 }
 

+++ b/mupen64plus-core/src/device/r4300/new_dynarec/new_dynarec.c
@@ -44,8 +44,41 @@ static int jit_writable = 0;
    iPhone allows a page to be writable or runnable, one at a time, switched with mprotect. The
    whole cache is switched at once, which is what the macOS per-thread toggle did too. */
 #include <sys/mman.h>
+#include <dlfcn.h>
 static void *jit_region = NULL;
 static size_t jit_region_size = 0;
+/* Continuum, part 2: an iPhone 13 or newer on iOS 26 will not let one page be both writable
+   and runnable, nor let a page that has ever been writable become runnable, so the mprotect
+   flip above cannot work there at all. The host instead has the JIT app bless one region and
+   hands out TWO addresses for the same memory: one to run code from, one to write it through.
+   Looked up by name so a build with no such host just takes the mprotect path above. */
+static int continuum_jit_region_lookup(const char *owner, size_t size, void **rx, void **rw)
+{
+   typedef int (*region_fn)(const char *, size_t, void **, void **);
+   static region_fn fn;
+   static int looked_up;
+   if (!looked_up) {
+      fn = (region_fn)dlsym(RTLD_DEFAULT, "continuum_jit_region");
+      looked_up = 1;
+   }
+   return fn ? fn(owner, size, rx, rw) : 0;
+}
+static void continuum_jit_region_give_back(void *rx)
+{
+   typedef void (*release_fn)(void *);
+   static release_fn fn;
+   static int looked_up;
+   if (!looked_up) {
+      fn = (release_fn)dlsym(RTLD_DEFAULT, "continuum_jit_release");
+      looked_up = 1;
+   }
+   if (fn)
+      fn(rx);
+}
+/* Set when base_addr/base_addr_rx are the host's pair rather than one mapping of our own.
+   jit_region stays NULL in that case, which is what makes the two helpers below no-ops:
+   neither view's permissions ever change, so there is nothing to flip. */
+static int jit_from_host_region = 0;
 static inline void jit_write_enable(void)
 {
    if (!jit_writable && jit_region)
@@ -9073,20 +9106,49 @@ void new_dynarec_init(void)
 
 #if defined(__APPLE__) && defined(__aarch64__) && defined(IOS)

-    else {
-      jit_region = base_addr;
-      jit_region_size = (size_t)1<<TARGET_SIZE_2;
+    // Continuum: iPhone.
+    //
+    // FIRST CHOICE, and the only one that works on an iPhone 13 or newer running iOS 26:
+    // the host's prepared region, which gives two addresses for the same 32MB — one to run
+    // code from, one to write it through. Those phones refuse to make a page that has ever
+    // been writable runnable, so the mprotect flip below cannot work on them at all.
+    //
+    // This needs NO new machinery in the recompiler. It is exactly the shape the Switch port
+    // already uses (CACHE_ADDR==DOUBLE_CACHE_ADDR, "RW address != RX address"), and every
+    // write-address-to-run-address translation it needs is already written: about twenty-five
+    // in this file (the `((intptr_t)x-(intptr_t)base_addr)+(intptr_t)base_addr_rx` pairs
+    // around the jump and hash tables) and thirteen in assem_arm64.c, where `out_rx` is
+    // derived from `out` for every PC-relative branch and for the jump table. `out` is based
+    // on base_addr, so the WRITE view goes there; execution and every cache flush use
+    // base_addr_rx. All four cache_flush call sites already pass run addresses.
+    void *region_rx = NULL;
+    void *region_rw = NULL;
+    if (continuum_jit_region_lookup("parallel_n64-new_dynarec",
+                                    (size_t)1<<TARGET_SIZE_2,
+                                    &region_rx, &region_rw)) {
+      base_addr    = region_rw;  // `out` writes here
+      base_addr_rx = region_rx;  // code runs here
+      jit_from_host_region = 1;
+      // Deliberately leaving jit_region NULL: both views keep fixed permissions, so
+      // jit_write_enable and jit_write_disable have nothing to do and become no-ops.
       jit_writable = 1;
-      jit_write_disable();
+      DebugMessage(M64MSG_INFO, "dynarec host region: rx=%p rw=%p", region_rx, region_rw);
+    } else {
+      // SECOND CHOICE: one mapping, flipped between writable and runnable with mprotect.
+      // Works on an iPhone 12 or older, or any phone without the newer restriction.
+      base_addr = mmap(NULL, 1<<TARGET_SIZE_2,
+                       PROT_READ | PROT_WRITE,
+                       MAP_PRIVATE | MAP_ANONYMOUS,
+                       -1, 0);
+      if(base_addr == (void*)-1) { DebugMessage(M64MSG_ERROR, "mmap failed: %d", errno); }
+      else {
+        jit_region = base_addr;
+        jit_region_size = (size_t)1<<TARGET_SIZE_2;
+        jit_writable = 1;
+        jit_write_disable();
+      }
+      base_addr_rx = base_addr;
     }
-    base_addr_rx = base_addr;
   }
 #elif defined(__APPLE__) && defined(__aarch64__)
   {
@@ -9218,11 +9280,21 @@ void new_dynarec_cleanup(void)
   #if defined(WIN32)
     VirtualFree(base_addr, 0, MEM_RELEASE);
   #elif defined(__APPLE__) && defined(__aarch64__)
-    if (munmap (base_addr, 1<<TARGET_SIZE_2) < 0) {DebugMessage(M64MSG_ERROR, "munmap() failed");}
     #if defined(IOS)
+    if (jit_from_host_region) {
+      /* The host owns this memory; it must be given back by its RUN address, which is the

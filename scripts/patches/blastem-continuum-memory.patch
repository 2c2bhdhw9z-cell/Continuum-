+//Continuum: Sega CD and 32X memory. The Sega CD is a genesis_context with a segacd_context
+//in expansion, so its work RAM is there too. Published as the memory map RetroAchievements
+//uses for the Sega CD (68K RAM at $FF0000, PRG RAM at $80020000, Word RAM at $200000),
+//all host-order 16-bit words like work_ram itself.
+static void publish_memory_maps(void)
+{
+	if (stype != SYSTEM_SEGACD && stype != SYSTEM_32X) {
+		return;
+	}
+	genesis_context *gen = (genesis_context *)current_system;
+	static struct retro_memory_descriptor desc[3];
+	memset(desc, 0, sizeof(desc));
+	desc[0].flags = RETRO_MEMDESC_SYSTEM_RAM;
+	desc[0].ptr = gen->work_ram;
+	desc[0].start = 0xFF0000;
+	desc[0].len = RAM_WORDS * sizeof(uint16_t);
+	if (stype == SYSTEM_32X) {
+		//32X SDRAM at $06000000, 256 KB of host-order words.
+		desc[1].flags = RETRO_MEMDESC_SYSTEM_RAM;
+		desc[1].ptr = gen->mars->sdram;
+		desc[1].start = 0x06000000;
+		desc[1].len = 256 * 1024;
+		struct retro_memory_map map32 = { desc, 2 };
+		retro_environment(RETRO_ENVIRONMENT_SET_MEMORY_MAPS, &map32);
+		return;
+	}
+	segacd_context *cd = gen->expansion;
+	//What load_save() does in the standalone build, which a libretro build never calls: a
+	//formatted, empty backup RAM, which the frontend's saved copy then replaces.
+	segacd_format_bram(cd->bram, 8 * 1024);
+	desc[1].flags = RETRO_MEMDESC_SYSTEM_RAM;
+	desc[1].ptr = cd->prog_ram;
+	desc[1].start = 0x80020000;
+	desc[1].len = 512 * 1024;
+	desc[2].flags = RETRO_MEMDESC_SYSTEM_RAM;
+	desc[2].ptr = cd->word_ram;
+	desc[2].start = 0x200000;
+	desc[2].len = 256 * 1024;
+	struct retro_memory_map map = { desc, 3 };
+	retro_environment(RETRO_ENVIRONMENT_SET_MEMORY_MAPS, &map);
+}

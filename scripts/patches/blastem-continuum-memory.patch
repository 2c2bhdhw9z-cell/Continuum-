+//Continuum: the multitap choice, which is several config keys rather than one, so it is
+//written here instead of through core_option::config_path. A Sega Team Player goes in the
+//first port with four pads on it and the second port is emptied, because find_gamepad()
+//takes the first port that claims a pad number and a pad left in port 2 would answer for
+//the tap's second pad. The EA 4-Way Play is one adapter across both ports, which is how
+//the real thing is wired. The pad numbers are what poll_input() sends: 1 to 4.
+static void apply_multitap(void)
+{
+	const char *value = core_option_value("blastem_multitap");
+	if (!value) {
+		value = multitap_values[0].value;
+	}
+	uint8_t sega = !strcmp(value, "sega");
+	if (!sega && strcmp(value, "ea")) {
+		return;
+	}
+	config = tern_insert_path(
+		config, "io\0devices\0" "1\0",
+		(tern_val){.ptrval = strdup(sega ? "sega_multitap.1" : "ea_multitap_port_a")}, TVAL_PTR
+	);
+	config = tern_insert_path(
+		config, "io\0devices\0" "2\0",
+		(tern_val){.ptrval = strdup(sega ? "none" : "ea_multitap_port_b")}, TVAL_PTR
+	);
+	for (int i = 0; i < 4; i++)
+	{
+		char sega_path[] = "io\0sega_multitap.1\0X\0";
+		char ea_path[] = "io\0ea_multitap\0X\0";
+		char pad[] = "gamepad6.X";
+		sega_path[19] = '1' + i;
+		ea_path[15] = '1' + i;
+		pad[9] = '1' + i;
+		config = tern_insert_path(config, sega ? sega_path : ea_path,
+		                          (tern_val){.ptrval = strdup(pad)}, TVAL_PTR);
+	}
+}
+
 //Every option that names a config path is simply written into the tree the
 //emulator reads while it builds a machine, which is why this has to run before
 //alloc_config_system() rather than at any later point.

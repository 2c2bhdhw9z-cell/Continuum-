diff --git a/continuum_32x_boot.s b/continuum_32x_boot.s
new file mode 100644
index 0000000..4c245ab
--- /dev/null
+++ b/continuum_32x_boot.s
@@ -0,0 +1,184 @@
+/*
+ * Continuum: 32X start-up code. What runs on each of the 32X's two SH-2 processors when the
+ * console is switched on and there is no usable 32X_M_BIOS.bin / 32X_S_BIOS.bin.
+ *
+ * Written for Continuum from the published description of what the 32X's start-up ROM has to do
+ * (the 32X hardware manual, section 5.1 "Boot ROM": the user header at $3C0-$3EF of the
+ * cartridge, the initial data load, "M_OK" and "S_OK" in the communication ports, the check sum
+ * in comm8), and from what the Mega Drive side's start-up program, which every 32X cartridge
+ * carries unchanged at $3F0, does and waits for. It is not Sega's code. GPL-3.0-or-later, like
+ * BlastEm.
+ *
+ * The master:  waits for the Mega Drive side to switch the adapter on; puts a mark in comm12;
+ *              clears SDRAM; puts the cartridge header's check sum ($18E) in comm8, where the
+ *              Mega Drive side waits for it; copies the game's SH-2 program from the cartridge to
+ *              SDRAM as the header says ($3D4 source, $3D8 destination, $3DC length); waits until
+ *              the Mega Drive side has finished with the 32X; writes "M_OK" to comm0; and starts
+ *              the game at its master entry ($3E0) with its vector base ($3E8) and the stack its
+ *              vector table names.
+ * The slave:   waits for the adapter, then for the master's "M_OK"; writes "S_OK" to comm4; and
+ *              starts the game at its slave entry ($3E4), vector base ($3EC).
+ *
+ * The wait for the Mega Drive side: its start-up program clears the 32X's frame buffers and
+ * palette AFTER it has started the SH-2s, and only then clears comm8 to comm14, as its last touch
+ * of the 32X (which takes the mark out of comm12). A game's SH-2 code that started before that
+ * could take the 32X's video away from it halfway through (measured in BlastEm: without this
+ * wait HexGL's SH-2 code was running 2 ms before the clearing ended). The wait gives up after
+ * well under a second, so an SH-2 reset with no start-up program behind it can never freeze a
+ * game.
+ *
+ * A console with no cartridge (a 32X CD) is not handled: the frontend asks for the real start-up
+ * files for those.
+ *
+ * Neither uses a stack. The cache goes on at once, as on the console, so the code itself runs
+ * from it; every byte of data is read and written through the cache-through addresses
+ * ($2xxxxxxx), so the cache never holds anything stale, and it is purged again just before the
+ * game starts.
+ *
+ * Built with GNU binutils for sh-elf (2.43.1 here), once for each processor:
+ *   sh-elf-as --isa=sh2 -big [--defsym SLAVE=1] -o boot.o continuum_32x_boot.s
+ *   sh-elf-ld -EB -Ttext=0 -e 0 -o boot.elf boot.o
+ *   sh-elf-objcopy -O binary -j .text boot.elf boot.bin
+ * and the two images go into continuum_32x_boot.h as bytes.
+ */
+
+	.text
+	.org	0
+
+/* The vector table at address 0, where an SH-2 looks when it comes out of reset. */
+vectors:
+	.long	start		/* power-on reset: PC */
+	.long	0x0603F000	/* power-on reset: SP (unused: nothing here calls or pushes) */
+	.long	start		/* manual reset: PC */
+	.long	0x0603F000	/* manual reset: SP */
+	.rept	252
+	.long	stop		/* any exception before the game takes over: stop here */
+	.endr
+
+start:
+	mov.l	regs, r0
+	ldc	r0, gbr
+	/* The cache on first, as the console's own start-up does it: this code is fetched from the
+	 * cached start-up area, and every byte of data goes through cache-through addresses. */
+	mov.l	ccr, r1
+	mov	#0x11, r0
+	mov.b	r0, @r1
+	/* Wait for the Mega Drive side to switch the adapter on: ADEN, bit 9 of $20004000. */
+wait_aden:
+	mov.b	@(0, gbr), r0
+	tst	#0x02, r0
+	bt	wait_aden
+	/* No cartridge (bit 8, a CD start): not ours. */
+	tst	#0x01, r0
+	bf	stop
+
+	mov.l	cart, r4
+	mov.l	header, r6
+	add	r4, r6			/* r6: the cartridge's user header, $3D4 on */
+
+.ifdef SLAVE
+
+	/* Wait for the master to have loaded the game: "M_OK" in comm0. */
+	mov.l	m_ok, r1
+wait_master:
+	mov.l	@(0x20, gbr), r0
+	cmp/eq	r1, r0
+	bf	wait_master
+	mov.l	s_ok, r0
+	mov.l	r0, @(0x24, gbr)	/* "S_OK" to comm4 */
+	mov.l	@(16, r6), r9		/* the slave's entry, $3E4 */
+	mov.l	@(24, r6), r10		/* its vector base, $3EC */
+	bra	start_game
+	nop
+
+.else
+
+	/* The mark in comm12, while the Mega Drive side is still at the start of its clearing. */
+	mov	#1, r0
+	mov.w	r0, @(0x2C, gbr)
+	/* Clear SDRAM, as the console does before it loads a game. */
+	mov.l	sdram, r1
+	mov.l	sdram_end, r2
+	mov	#0, r3
+clear:
+	mov.l	r3, @r1
+	add	#4, r1
+	cmp/hs	r2, r1
+	bf	clear
+	/* The header's check sum to comm8: the Mega Drive side compares it with its own copy. */
+	mov.l	checksum, r0
+	mov.w	@(r0, r4), r0
+	mov.w	r0, @(0x28, gbr)
+	/* The initial data load: whole longwords from the cartridge to SDRAM, never past its end. */
+	mov.l	@r6, r5			/* source, from the start of the cartridge */
+	mov.l	@(4, r6), r7		/* destination, from the start of SDRAM */
+	mov.l	@(8, r6), r8		/* length in bytes */
+	mov.l	rom_mask, r0
+	and	r0, r5
+	add	r4, r5
+	mov.l	sdram_mask, r0
+	and	r0, r7
+	mov.l	sdram, r0
+	add	r0, r7
+copy:
+	mov	#4, r0
+	cmp/hs	r0, r8			/* T: at least a longword left */
+	bf	copied
+	cmp/hs	r2, r7			/* T: at the end of SDRAM */
+	bt	copied
+	mov.l	@r5+, r0
+	mov.l	r0, @r7
+	add	#4, r7
+	bra	copy
+	add	#-4, r8			/* (delay slot) */
+copied:
+	/* Wait until the Mega Drive side has finished with the 32X: the mark in comm12 gone. */
+	mov.l	patience, r3
+wait_md:
+	mov.w	@(0x2C, gbr), r0
+	tst	r0, r0
+	bt	md_done
+	dt	r3
+	bf	wait_md
+	/* Gave up: take the mark out if it is still there, so the game finds comm12 as the console's
+	 * own start-up leaves it. */
+	cmp/eq	#1, r0
+	bf	md_done
+	mov	#0, r0
+	mov.w	r0, @(0x2C, gbr)
+md_done:
+	mov.l	m_ok, r0
+	mov.l	r0, @(0x20, gbr)	/* "M_OK" to comm0 */
+	mov.l	@(12, r6), r9		/* the master's entry, $3E0 */
+	mov.l	@(20, r6), r10		/* its vector base, $3E8 */
+
+.endif
+
+/* r9: the game's entry, r10: its vector base. The cache purged (and left on), the game's vector
+ * base, the stack its own vector table gives, and off it goes. */
+start_game:
+	mov.l	ccr, r1
+	mov	#0x11, r0
+	mov.b	r0, @r1
+	ldc	r10, vbr
+	mov.l	@(4, r10), r15
+	jmp	@r9
+	nop
+
+stop:
+	bra	stop
+	nop
+
+	.align	2
+regs:		.long	0x20004000	/* the 32X's registers, cache-through */
+cart:		.long	0x22000000	/* the cartridge, cache-through */
+header:		.long	0x000003D4
+m_ok:		.long	0x4D5F4F4B	/* "M_OK" */
+s_ok:		.long	0x535F4F4B	/* "S_OK" */
+sdram:		.long	0x26000000	/* SDRAM, cache-through */
+sdram_end:	.long	0x26040000
+checksum:	.long	0x0000018E
+rom_mask:	.long	0x003FFFFC
+sdram_mask:	.long	0x0003FFFC
+patience:	.long	0x00200000	/* tries before the wait gives up: about 0.6 s */
+ccr:		.long	0xFFFFFE92	/* the SH-2's cache control register */

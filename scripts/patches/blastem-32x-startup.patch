+//Continuum: 32X start-up code. One SH-2's start-up file at `path` into `buffer`, the `size` bytes
+//of its boot ROM window, in host order, when the file is usable by sh2_bios_usable()'s rule in
+//libblastem.c: at least a reset vector, and not a zero one (an empty placeholder would start the
+//SH-2 on zeroes). Returns 0, with `buffer` left as zeroes, when it is not.
+static uint8_t continuum_read_boot_file(void *buffer, uint32_t size, const char *path)
+{
+	media_file *f = media_fopen(path, "rb");
+	if (!f) {
+		return 0;
+	}
+	size_t got = media_fread(buffer, 1, size, f);
+	media_fclose(f);
+	uint8_t *bytes = buffer;
+	if (got < 4 || !(bytes[0] | bytes[1] | bytes[2] | bytes[3])) {
+		memset(buffer, 0, size);
+		return 0;
+	}
+	byteswap_rom(size, buffer);
+	return 1;
+}
+
+//Continuum: 32X start-up code. Continuum's own start-up code for one SH-2 (continuum_32x_boot.s)
+//into its boot ROM window, in place of whatever was read there.
+static void continuum_use_own_boot(void *buffer, uint32_t size, const uint8_t *own, uint32_t own_size)
+{
+	memset(buffer, 0, size);
+	memcpy(buffer, own, own_size);
+	byteswap_rom(size, buffer);
+}

<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Continuum</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.8.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>16.0</string>

	<!-- Metal is not optional: the renderer is wgpu on Metal with no fallback path. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>

	<!-- A storyboard-free launch screen. Without a UILaunchScreen key iOS falls back to
	     legacy behaviour and can letterbox the app on modern displays. -->
	<key>UILaunchScreen</key>
	<dict/>

	<!-- Multi-file cue/bin support (Option 2): UIFileSharingEnabled exposes the app's
	     Documents directory in the Files app / Finder, and LSSupportsOpeningDocumentsInPlace
	     lets the app open documents in place. Together they let a user drag a folder of a
	     .cue plus its .bin tracks straight into Documents (inside the sandbox, so no security
	     scope is needed) as an alternative to the folder picker. These keys are the reference
	     seed only: xcodegen injects them into the built app from project.yml info.properties. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Games that listen, such as 3DS games you blow into, can hear the microphone while you play. Only used when Allow microphone in games is on.</string>
	<key>NSCameraUsageDescription</key>
	<string>Games that use a camera, such as 3DS camera games, can see the camera while you play. Only used when Allow camera in games is on.</string>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<!-- Online play: Local Network permission text, and the Bonjour type the host advertises and
	     the guest browses. Mirrors project.yml info.properties. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Continuum uses the local network for two-player online play with another phone, for Wi-Fi transfer of games and saves from a computer's browser, and to browse a NAS or computer over WebDAV or SMB file sharing.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_continuum._tcp</string>
	</array>

